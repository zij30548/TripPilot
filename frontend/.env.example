NEXT_PUBLIC_AMAP_JS_KEY=
# Server-only, canonical origin. Production build AND start require the same value.
# Development alone defaults to http://127.0.0.1:8000 when omitted.
TRIPPILOT_BACKEND_ORIGIN=http://127.0.0.1:8000
# No NEXT_PUBLIC backend URL/serviceHost: browser uses /api/* and /_AMapService.

AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# Exact page origins permitted in SDK appname metadata (JSON list, server-only).
# For deployment replace with your trusted HTTPS site origin; this is NOT CORS.
AMAP_ALLOWED_PAGE_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-flash-2026-07-15
# Independent photo recognition model; same server-only Beijing credentials.
QWEN_VISION_MODEL=qwen3-vl-plus
# Invitation-only identity; server-side only. Secure defaults to true.
# Local HTTP ONLY: export AUTH_COOKIE_SECURE=false before launching uvicorn.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTH_SESSION_SECONDS=28800
# Optional absolute path. Default: backend/data/trippilot-private.sqlite3.
# Never point this at the old backend/data/saved-trips.sqlite3.
# TRIPPILOT_DATABASE_PATH=/absolute/private/path/trippilot-private.sqlite3
# Business budgets are independent from identity/archive storage. Explicitly
# initialize ONCE with tools.business_usage init before enabling charged work.
# Runtime never initializes/replaces a missing ledger or its .identity anchor.
# BUSINESS_USAGE_PATH=/absolute/private/path/business-usage.sqlite3
BUSINESS_RATE_WINDOW_SECONDS=60
BUSINESS_RATE_ACCOUNT_LIMIT=60
BUSINESS_RATE_GLOBAL_LIMIT=300
# Attempts/jobs, NOT RMB: Shanghai calendar-day limits, 0 disables that class.
# Set all eight exact service keys; account and global apply simultaneously.
BUSINESS_DAILY_LIMITS={"amap_poi":{"account":200,"global":2000},"amap_route":{"account":600,"global":6000},"amap_weather":{"account":20,"global":200},"amap_proxy":{"account":40,"global":400},"qwen_text":{"account":10,"global":50},"qwen_vision":{"account":5,"global":25},"media_photo":{"account":10,"global":100},"media_video":{"account":5,"global":25}}

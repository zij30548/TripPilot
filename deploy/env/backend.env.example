# systemd EnvironmentFile: JSON values use outer SINGLE quotes, not shell export.
# Server-only credentials; blank means the corresponding provider is unavailable.
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
AMAP_ALLOWED_PAGE_ORIGINS='["https://trip.zijinglab.com"]'
QWEN_API_KEY=
# Beijing public URL below, or https://<workspace>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Use the console URL; one workspace label (1-63 ASCII letters/digits, internal hyphens).
# Optional trailing slash; no port, credentials, query, fragment or other region.
# Existing /etc/trippilot/*.env must be edited in place and checked, never replaced by this template.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_VISION_MODEL=qwen3-vl-plus
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS='["https://trip.zijinglab.com"]'
AUTH_SESSION_SECONDS=28800
TRIPPILOT_DATABASE_PATH=/var/lib/trippilot/identity.sqlite3
BUSINESS_USAGE_PATH=/var/lib/trippilot/usage.sqlite3
# Optional explicit cutover only AFTER the reviewed copy migration and verification.
# Blank preserves SQLite; existing files do not need these keys until cutover.
# MySQL production policy: mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/trippilot
# Optional ?charset=utf8mb4; USER=ASCII letters/digits/underscore (1-32),
# PASSWORD=URL-safe letters/digits/_/- (16-256), no percent escapes or shell expansion.
# Never copy a real URL to logs, screenshots, shell history or the frontend file.
TRIPPILOT_MYSQL_URL=
# Set this exact existing anchor path with MySQL; never create a new anchor to reset quota.
BUSINESS_USAGE_IDENTITY_PATH=
BUSINESS_RATE_WINDOW_SECONDS=60
BUSINESS_RATE_ACCOUNT_LIMIT=60
BUSINESS_RATE_GLOBAL_LIMIT=300
BUSINESS_DAILY_LIMITS='{"amap_poi":{"account":200,"global":2000},"amap_route":{"account":600,"global":6000},"amap_weather":{"account":20,"global":200},"amap_proxy":{"account":40,"global":400},"qwen_text":{"account":10,"global":50},"qwen_vision":{"account":5,"global":25},"media_photo":{"account":10,"global":100},"media_video":{"account":5,"global":25}}'

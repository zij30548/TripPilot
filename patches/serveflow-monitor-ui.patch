+++ b/src/lib/monitorStats.js
@@ -0,0 +1,134 @@
+const AGENT_LABELS = Object.freeze({
+  general: '通用接待', technical: '技术支持', billing: '账单服务', escalation: '人工交接'
+})
+const TOOL_LABELS = Object.freeze({
+  knowledge_search: '知识检索', search_knowledge_base: '知识库查询',
+  inspect_request_context: '请求核对', suggest_required_fields: '补充信息',
+  lookup_error_code: '错误码查询', build_diagnostic_plan: '排障建议',
+  check_billing_fields: '账单核对', compare_amounts: '金额比较',
+  create_handoff_summary: '交接摘要', read_demo_order: '演示订单查询'
+})
+const AGENT_ORDER = Object.keys(AGENT_LABELS)
+const RECOVERY = Object.freeze({ healthy: '正常', cooldown: '冷却中', probing: '恢复探测' })
+const CIRCUIT = Object.freeze({ closed: '正常', open: '已熔断', half_open: '恢复探测' })
+const ALERT_METRICS = Object.freeze({
+  agent_success_rate: { label: '执行成功率', type: 'agent', unit: 'rate' },
+  agent_avg_ms: { label: '平均耗时', type: 'agent', unit: 'ms' },
+  tool_success_rate: { label: '执行成功率', type: 'tool', unit: 'rate' },
+  tool_avg_ms: { label: '平均耗时', type: 'tool', unit: 'ms' }
+})
+const SEVERITY = Object.freeze({ info: '提示', warning: '提醒', error: '异常', critical: '严重异常' })
+
+function record(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function number(value, maximum = Number.MAX_SAFE_INTEGER) {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= maximum ? value : null
+}
+
+function count(value) {
+  return Number.isSafeInteger(value) && value >= 0 ? value : null
+}
+
+function agentIdentity(value) {
+  const match = /^(general|technical|billing|escalation)_([0-9]{1,2})$/.exec(value)
+  return match ? { label: `${AGENT_LABELS[match[1]]} · ${Number(match[2]) + 1}`, group: match[1], instance: Number(match[2]) } : null
+}
+
+function rowsFor(input, kind) {
+  const rows = []
+  let rejected = 0
+  if (!record(input)) return { rows, rejected: 0, available: false }
+  for (const [id, raw] of Object.entries(input).slice(0, 100)) {
+    const identity = kind === 'agent' ? agentIdentity(id) : Object.hasOwn(TOOL_LABELS, id) ? { label: TOOL_LABELS[id] } : null
+    if (!identity || !record(raw)) { rejected++; continue }
+    const total = count(raw.total)
+    const sampled = total !== null && total > 0
+    const state = kind === 'agent' ? raw.recovery_state : raw.circuit_state
+    const states = kind === 'agent' ? RECOVERY : CIRCUIT
+    rows.push({
+      id, label: identity.label, group: identity.group, instance: identity.instance,
+      total, sampled,
+      rate: sampled ? number(raw.success_rate, 1) : null,
+      averageMs: sampled ? number(kind === 'agent' ? raw.avg_ms : raw.avg_latency_ms) : null,
+      state: Object.hasOwn(states, state) ? states[state] : '未知',
+      stateTone: state === 'open' || state === 'cooldown' ? 'warning' : state === 'half_open' || state === 'probing' ? 'pending' : state === 'healthy' || state === 'closed' ? 'healthy' : 'unknown',
+      consecutiveFails: kind === 'tool' ? count(raw.consecutive_fails) : null
+    })
+  }
+  if (Object.keys(input).length > 100) rejected += Object.keys(input).length - 100
+  rows.sort((a, b) => kind === 'agent'
+    ? AGENT_ORDER.indexOf(a.group) - AGENT_ORDER.indexOf(b.group) || a.instance - b.instance
+    : a.id.localeCompare(b.id))
+  return { rows, rejected, available: true }
+}
+
+function aggregate(group) {
+  const { rows } = group
+  if (!group.available || group.rejected || rows.some(row => row.total === null)) return { total: null, rate: null, averageMs: null }
+  const total = rows.reduce((sum, row) => sum + row.total, 0)
+  if (!Number.isSafeInteger(total)) return { total: null, rate: null, averageMs: null }
+  const sampled = rows.filter(row => row.total > 0)
+  if (!total) return { total, rate: null, averageMs: null }
+  const weighted = field => sampled.some(row => row[field] === null) ? null
+    : sampled.reduce((sum, row) => sum + row.total / total * row[field], 0)
+  return { total, rate: weighted('rate'), averageMs: weighted('averageMs') }
+}
+
+function alertsFor(value) {
+  if (!Array.isArray(value)) return []
+  const seen = new Set()
+  const alerts = []
+  for (const raw of value.slice(-10)) {
+    if (!record(raw) || raw.resolved === true || !Object.hasOwn(SEVERITY, raw.severity) || typeof raw.metric !== 'string') continue
+    const [metric, identifier, extra] = raw.metric.split(':')
+    const definition = ALERT_METRICS[metric]
+    if (!definition || extra !== undefined) continue
+    const subject = definition.type === 'agent' ? agentIdentity(identifier)?.label
+      : Object.hasOwn(TOOL_LABELS, identifier) ? TOOL_LABELS[identifier] : null
+    const maximum = definition.unit === 'rate' ? 1 : Number.MAX_SAFE_INTEGER
+    const measured = number(raw.value, maximum)
+    const threshold = number(raw.threshold, maximum)
+    if (!subject || measured === null || threshold === null) continue
+    const key = `${raw.metric}:${raw.value}:${raw.threshold}:${raw.severity}`
+    if (seen.has(key)) continue
+    seen.add(key)
+    alerts.push({ key, severity: SEVERITY[raw.severity], tone: ['error', 'critical'].includes(raw.severity) ? 'warning' : 'pending',
+      label: `${subject} · ${definition.label}`, value: definition.unit === 'rate' ? formatMonitorRate(measured) : formatMonitorDuration(measured),
+      threshold: definition.unit === 'rate' ? formatMonitorRate(threshold) : formatMonitorDuration(threshold) })
+  }
+  return alerts
+}
+
+export function projectMonitorSnapshot(snapshot) {
+  const raw = record(snapshot) ? snapshot : {}
+  const agents = rowsFor(raw.agent_stats, 'agent')
+  const tools = rowsFor(raw.tool_stats, 'tool')
+  return {
+    available: record(snapshot) && agents.available && tools.available,
+    agents: agents.rows, tools: tools.rows,
+    agentSummary: aggregate(agents), toolSummary: aggregate(tools),
+    alerts: alertsFor(raw.active_alerts),
+    incomplete: agents.rejected > 0 || tools.rejected > 0,
+    metricScope: 'technical-execution'
+  }
+}
+
+export function formatMonitorCount(value) {
+  return count(value) === null ? '—' : String(value)
+}
+
+export function formatMonitorRate(value) {
+  return number(value, 1) === null ? '—' : `${(value * 100).toFixed(1)}%`
+}
+
+export function formatMonitorDuration(value) {
+  if (number(value) === null) return '—'
+  return value >= 1000 ? `${(value / 1000).toFixed(2)} s` : `${Math.round(value)} ms`
+}
+
+export function formatMonitorReadTime(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}T/.test(value) || !Number.isFinite(Date.parse(value))) return '—'
+  return new Date(value).toLocaleString('zh-CN', { hour12: false })
+}
diff --git a/tests/monitorStats.test.js b/tests/monitorStats.test.js
new file mode 100644
index 0000000..703c6ad
--- /dev/null
+++ b/tests/monitorStats.test.js
@@ -0,0 +1,91 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { projectMonitorSnapshot, formatMonitorCount, formatMonitorRate, formatMonitorDuration, formatMonitorReadTime } from '../src/lib/monitorStats.js'
+
+const agent = (total, success_rate, avg_ms) => ({ total, success_rate, avg_ms, recovery_state: 'healthy' })
+const tool = (total, success_rate, avg_latency_ms) => ({ total, success_rate, avg_latency_ms, circuit_state: 'closed', consecutive_fails: 0 })
+
+test('zero backend samples never become a fabricated 100 percent success rate', () => {
+  const view = projectMonitorSnapshot({ agent_stats: { general_0: agent(0, 1, 0) }, tool_stats: { knowledge_search: tool(0, 1, 0) } })
+  assert.equal(view.available, true)
+  assert.deepEqual(view.agentSummary, { total: 0, rate: null, averageMs: null })
+  assert.equal(view.agents[0].sampled, false)
+  assert.equal(view.agents[0].rate, null)
+  assert.equal(view.tools[0].averageMs, null)
+  assert.equal(view.metricScope, 'technical-execution')
+})
+
+test('summary counts role executions and weights reported rate and latency without inventing success counts', () => {
+  const view = projectMonitorSnapshot({ agent_stats: { general_0: agent(2, 1, 100), billing_0: agent(6, .5, 300) }, tool_stats: { knowledge_search: tool(3, 1, 20) } })
+  assert.deepEqual(view.agentSummary, { total: 8, rate: .625, averageMs: 250 })
+  assert.equal(view.toolSummary.total, 3)
+  assert.equal('successCount' in view.agentSummary, false)
+  assert.equal(view.agents[1].label, '账单服务 · 1')
+})
+
+test('invalid numbers are unknown, never coerced or clamped into good metrics', () => {
+  for (const invalid of [NaN, Infinity, -1, '4', null, true]) {
+    const view = projectMonitorSnapshot({ agent_stats: { general_0: agent(invalid, .9, 25) }, tool_stats: {} })
+    assert.equal(view.agentSummary.total, null)
+    assert.equal(view.agents[0].rate, null)
+    assert.equal(formatMonitorCount(invalid), '—')
+  }
+  const view = projectMonitorSnapshot({ agent_stats: { general_0: agent(3, 95, Infinity) }, tool_stats: {} })
+  assert.equal(view.agentSummary.total, 3)
+  assert.equal(view.agentSummary.rate, null)
+  assert.equal(view.agentSummary.averageMs, null)
+})
+
+test('fractional success values have one scale and missing values do not turn into zero', () => {
+  assert.equal(formatMonitorRate(.953), '95.3%')
+  assert.equal(formatMonitorRate(1), '100.0%')
+  assert.equal(formatMonitorRate(95), '—')
+  assert.equal(formatMonitorRate(null), '—')
+  assert.equal(formatMonitorDuration(0), '0 ms')
+  assert.equal(formatMonitorDuration(1500), '1.50 s')
+  assert.equal(formatMonitorDuration(undefined), '—')
+})
+
+test('projection never exposes role prompts, customer text, unknown identifiers or server advice bodies', () => {
+  const view = projectMonitorSnapshot({
+    agent_stats: { general_0: { ...agent(1, 1, 50), role: 'secret role', workflow: ['customer message'] }, 'customer-private-name': agent(1, 1, 1) },
+    tool_stats: { 'secret-tool-id': tool(1, 1, 1), knowledge_search: tool(1, 1, 10) },
+    suggestions: [{ title: 'private title', action: 'private action' }],
+    active_alerts: [{ severity: 'error', metric: 'agent_success_rate:general_0', value: .5, threshold: .9, message: 'private payload' }]
+  })
+  const serialized = JSON.stringify(view)
+  for (const forbidden of ['secret role', 'customer message', 'customer-private-name', 'secret-tool-id', 'private title', 'private action', 'private payload']) {
+    assert.equal(serialized.includes(forbidden), false)
+  }
+  assert.equal(view.incomplete, true)
+  assert.equal(view.agentSummary.total, null)
+  assert.equal(view.alerts[0].label, '通用接待 · 1 · 执行成功率')
+})
+
+test('unavailable snapshots stay unavailable and unsafe counter totals are not added', () => {
+  for (const input of [null, undefined, [], {}, { agent_stats: [], tool_stats: {} }]) {
+    assert.equal(projectMonitorSnapshot(input).available, false)
+  }
+  const view = projectMonitorSnapshot({ agent_stats: { general_0: agent(Number.MAX_SAFE_INTEGER, 1, 1), technical_0: agent(1, 1, 1) }, tool_stats: {} })
+  assert.equal(view.agentSummary.total, null)
+})
+
+test('alert projection uses only recognized metrics and deduplicates repeated threshold samples', () => {
+  const alert = { severity: 'warning', metric: 'tool_avg_ms:knowledge_search', value: 6000, threshold: 5000 }
+  const view = projectMonitorSnapshot({ agent_stats: {}, tool_stats: {}, active_alerts: [
+    alert, alert, { ...alert, metric: 'secret:customer' }, { ...alert, value: Infinity }, { ...alert, resolved: true },
+    { ...alert, metric: 'tool_success_rate:knowledge_search', value: 95, threshold: .95 }
+  ] })
+  assert.equal(view.alerts.length, 1)
+  assert.equal(view.alerts[0].value, '6.00 s')
+  assert.equal(view.alerts[0].threshold, '5.00 s')
+})
+
+test('known recovery and circuit states are fixed labels; arbitrary strings do not reach the page', () => {
+  const view = projectMonitorSnapshot({ agent_stats: { general_0: { ...agent(3, 1, 0), recovery_state: 'cooldown' } }, tool_stats: { knowledge_search: { ...tool(2, .5, 20), circuit_state: 'open' } } })
+  assert.equal(view.agents[0].state, '冷却中')
+  assert.equal(view.tools[0].state, '已熔断')
+  const invalid = projectMonitorSnapshot({ agent_stats: { general_0: { ...agent(1, 1, 1), recovery_state: 'private failure text' } }, tool_stats: {} })
+  assert.equal(invalid.agents[0].state, '未知')
+  assert.equal(formatMonitorReadTime('private time text'), '—')
+})
diff --git a/tests/frontendSettings.test.js b/tests/frontendSettings.test.js
new file mode 100644
index 0000000..503f8ed
--- /dev/null
+++ b/tests/frontendSettings.test.js
@@ -0,0 +1,74 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createInitialSettings, requestMonitor, saveSettings } from '../src/lib/backends.js'
+
+test('old Java selection cannot change the Python-only product entry', () => {
+  const previous = globalThis.localStorage
+  globalThis.localStorage = { getItem: () => JSON.stringify({ backend: 'java', userId: 'old-user',
+    endpoints: { python: '/api/python', java: '/old-java' } }) }
+  try {
+    const settings = createInitialSettings()
+    assert.equal(settings.backend, 'python')
+    assert.equal(settings.endpoints.python, '/api/python')
+    assert.equal(settings.userId, 'old-user')
+  } finally { globalThis.localStorage = previous }
+})
+
+test('saved product settings keep Python fixed without persisting credentials', () => {
+  const previous = globalThis.localStorage
+  let stored
+  globalThis.localStorage = { setItem: (_, value) => { stored = JSON.parse(value) } }
+  try {
+    saveSettings({ backend: 'java', pythonToken: 'test-only-secret', endpoints: { python: '/api/python' } })
+    assert.equal(stored.backend, 'python')
+    assert.equal(stored.pythonToken, undefined)
+    assert.equal(stored.endpoints.python, '/api/python')
+  } finally { globalThis.localStorage = previous }
+})
+
+test('monitor remains a readonly request with caller cancellation and no retry', async () => {
+  const previous = globalThis.fetch
+  const calls = []
+  const controller = new AbortController()
+  globalThis.fetch = async (url, options) => {
+    calls.push({ url, options })
+    return new Response(JSON.stringify({ agent_stats: {}, tool_stats: {} }), { status: 200 })
+  }
+  try {
+    await requestMonitor('python', { endpoints: { python: '/api/python' }, userId: 'demo' }, { signal: controller.signal })
+    assert.equal(calls.length, 1)
+    assert.equal(calls[0].url, '/api/python/monitor')
+    assert.equal(calls[0].options.method, undefined)
+    assert.notEqual(calls[0].options.signal, controller.signal)
+    assert.equal(calls[0].options.signal.aborted, false)
+    controller.abort()
+    assert.equal(calls[0].options.signal.aborted, true)
+    assert.equal(calls[0].options.credentials, 'same-origin')
+  } finally { globalThis.fetch = previous }
+})
+
+test('monitor keeps its timeout when a caller also supplies cancellation', async () => {
+  const previousFetch = globalThis.fetch
+  const previousTimeout = AbortSignal.timeout
+  const deadline = new AbortController()
+  const caller = new AbortController()
+  let signal
+  AbortSignal.timeout = milliseconds => {
+    assert.equal(milliseconds, 20000)
+    return deadline.signal
+  }
+  globalThis.fetch = async (_, options) => {
+    signal = options.signal
+    return new Response('{}', { status: 200 })
+  }
+  try {
+    await requestMonitor('python', { endpoints: { python: '/api/python' }, userId: 'demo' }, { signal: caller.signal })
+    assert.equal(signal.aborted, false)
+    deadline.abort()
+    assert.equal(signal.aborted, true)
+    assert.equal(caller.signal.aborted, false)
+  } finally {
+    globalThis.fetch = previousFetch
+    AbortSignal.timeout = previousTimeout
+  }
+})

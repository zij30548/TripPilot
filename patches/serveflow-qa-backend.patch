diff --git a/core/provider_options.py b/core/provider_options.py
new file mode 100644
index 0000000..456ad39
--- /dev/null
+++ b/core/provider_options.py
@@ -0,0 +1,39 @@
+"""Narrow provider compatibility options; never change arbitrary endpoints.
+
+Only the explicitly supported Beijing Flash snapshot uses Bailian's native
+Anthropic thinking switch. No URL, credential or provider error is logged here.
+"""
+from __future__ import annotations
+
+import re
+from typing import Any
+from urllib.parse import urlsplit
+
+FLASH_SNAPSHOT = "qwen3.7-flash-2026-07-15"
+_WORKSPACE_HOST = re.compile(
+    r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.cn-beijing\.maas\.aliyuncs\.com\Z"
+)
+
+
+def nonthinking_options(client: Any, model: str) -> dict[str, Any]:
+    """Return request options only for the real client's exact official origin.
+
+    A prompt, environment name, selected role or caller-supplied model alias
+    cannot opt another provider into this compatibility behavior.
+    """
+    if model != FLASH_SNAPSHOT:
+        return {}
+    try:
+        base = urlsplit(str(getattr(client, "base_url", "")))
+        host = base.hostname
+        if (base.scheme != "https" or host is None
+                or not (host == "dashscope.aliyuncs.com" or _WORKSPACE_HOST.fullmatch(host))
+                or base.port not in {None, 443} or base.username is not None or base.password is not None
+                or base.query or base.fragment or base.path not in {"/apps/anthropic", "/apps/anthropic/"}):
+            return {}
+    except (TypeError, ValueError, UnicodeError):
+        return {}
+    # The pinned Anthropic 0.40 SDK predates the typed ``thinking`` keyword.
+    # extra_body is its supported extension hook and serializes this as the
+    # exact top-level HTTP JSON field, without upgrading the original SDK.
+    return {"extra_body": {"thinking": {"type": "disabled"}}}
diff --git a/core/safe_diagnostics.py b/core/safe_diagnostics.py
new file mode 100644
index 0000000..50a3d88
--- /dev/null
+++ b/core/safe_diagnostics.py
@@ -0,0 +1,69 @@
+"""Bounded LLM failure metadata; never render exception messages or payloads."""
+
+import asyncio
+import json
+import math
+
+from anthropic import (
+    APIConnectionError,
+    APIStatusError,
+    APITimeoutError,
+    AuthenticationError,
+    BadRequestError,
+    PermissionDeniedError,
+    RateLimitError,
+)
+
+
+_PHASES = frozenset({
+    "intent.transport", "intent.parse", "intent.validate",
+    "composer.transport", "composer.extract",
+    "retrieval.rewrite", "retrieval.rerank",
+    "memory.profile", "memory.summary", "memory.merge",
+})
+_ERRORS = (
+    (asyncio.CancelledError, "CancelledError", "cancelled"),
+    (TimeoutError, "TimeoutError", "deadline_exceeded"),
+    (APITimeoutError, "APITimeoutError", "deadline_exceeded"),
+    (AuthenticationError, "AuthenticationError", "authentication_failed"),
+    (PermissionDeniedError, "PermissionDeniedError", "permission_denied"),
+    (RateLimitError, "RateLimitError", "rate_limited"),
+    (BadRequestError, "BadRequestError", "provider_request_rejected"),
+    (APIConnectionError, "APIConnectionError", "connection_failed"),
+    (APIStatusError, "APIStatusError", "provider_status_error"),
+    (json.JSONDecodeError, "JSONDecodeError", "invalid_json"),
+    (TypeError, "TypeError", "invalid_structure"),
+    (KeyError, "KeyError", "invalid_structure"),
+    (ValueError, "ValueError", "invalid_semantics"),
+)
+
+
+def record_llm_failure(logger, phase, error, elapsed_ms, *, empty_output=False):
+    """Log fixed vocabulary and bounded timing, excluding exception repr/str.
+
+    These categories describe an observed failure, not upstream root causality.
+    Unknown exception classes are deliberately collapsed to OtherError.
+    """
+    safe_phase = phase if phase in _PHASES else "unknown"
+    error_type, error_code = "OtherError", "unexpected_error"
+    if empty_output:
+        error_type, error_code = "None", "empty_output"
+    else:
+        for kind, label, code in _ERRORS:
+            if isinstance(error, kind):
+                error_type, error_code = label, code
+                break
+    safe_elapsed = 0
+    if isinstance(elapsed_ms, (int, float)) and not isinstance(elapsed_ms, bool) and math.isfinite(elapsed_ms):
+        safe_elapsed = int(min(3_600_000, max(0, elapsed_ms)))
+    diagnostic = {
+        "phase": safe_phase,
+        "error_code": error_code,
+        "error_type": error_type,
+        "elapsed_ms": safe_elapsed,
+    }
+    logger.warning(
+        "llm_failure phase=%s error_code=%s error_type=%s elapsed_ms=%d",
+        safe_phase, error_code, error_type, safe_elapsed,
+    )
+    return diagnostic
diff --git a/tests/test_native_tool_protocol.py b/tests/test_native_tool_protocol.py
new file mode 100644
index 0000000..2565184
--- /dev/null
+++ b/tests/test_native_tool_protocol.py
@@ -0,0 +1,148 @@
+"""Native response-boundary checks with mocked providers; no model or DB calls."""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+import httpx
+from anthropic import APITimeoutError
+
+from agents.agent_orchestrator import GeneralAgent, Request
+from agents.tools import make_tool
+
+
+def tool_block(*, tool_id="toolu_valid", arguments=None):
+    return {"type": "tool_use", "id": tool_id, "name": "probe",
+            "input": {} if arguments is None else arguments}
+
+
+def response(blocks, stop="tool_use"):
+    return SimpleNamespace(content=blocks, stop_reason=stop)
+
+
+def setup_agent(responses):
+    provider = AsyncMock(side_effect=responses)
+    handler = AsyncMock(return_value={"success": True})
+    agent = GeneralAgent(SimpleNamespace(messages=SimpleNamespace(create=provider)), "controlled-model")
+    agent.set_shared_tools({"probe": make_tool("probe", "Controlled read", {}, handler)})
+    req = Request(message="controlled query", user_id="isolated", conv_id="controlled")
+    return agent, provider, handler, req
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("arguments", [None, [], 0, "", False, ["value"], "{}"])
+async def test_non_object_input_rejected_without_dispatch_or_repair(arguments):
+    block = tool_block()
+    block["input"] = arguments
+    agent, provider, handler, req = setup_agent([response([block])])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_protocol_error"
+    assert result.tools_used == result.tool_traces == req.tool_attempts == []
+    handler.assert_not_called()
+    assert provider.await_count == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("tool_id", [None, "", " ", "tool with space", "bad\n", "x" * 201, 7, "工具"])
+async def test_invalid_id_rejected_before_dispatch(tool_id):
+    agent, provider, handler, req = setup_agent([response([tool_block(tool_id=tool_id)])])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_protocol_error"
+    assert result.tools_used == req.tool_attempts == []
+    handler.assert_not_called()
+    assert provider.await_count == 1
+
+
+@pytest.mark.asyncio
+async def test_missing_id_rejected_before_dispatch():
+    block = tool_block()
+    del block["id"]
+    agent, provider, handler, req = setup_agent([response([block])])
+    result = await agent.handle(req)
+    assert result.error_code == "agent_protocol_error"
+    handler.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("second", [
+    tool_block(tool_id="toolu_valid"), tool_block(tool_id=None),
+    tool_block(tool_id="toolu_second", arguments=[]),
+    {**tool_block(tool_id="toolu_second"), "input": None},
+])
+async def test_entire_batch_checked_before_first_handler(second):
+    agent, provider, handler, req = setup_agent([response([tool_block(), second])])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_protocol_error"
+    assert result.tools_used == result.tool_traces == req.tool_attempts == []
+    handler.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_duplicate_id_in_later_round_preserves_only_prior_execution():
+    agent, provider, handler, req = setup_agent([response([tool_block()]), response([tool_block()])])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_protocol_error"
+    assert provider.await_count == 2 and handler.await_count == 1
+    assert result.tools_used == ["probe"]
+    assert [trace["tool_use_id"] for trace in result.tool_traces] == ["toolu_valid"]
+    assert len(req.tool_attempts) == 1
+
+
+@pytest.mark.asyncio
+async def test_truncated_tool_response_never_dispatches():
+    agent, provider, handler, req = setup_agent([response([tool_block()], stop="max_tokens")])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_protocol_error"
+    assert result.tools_used == result.tool_traces == req.tool_attempts == []
+    handler.assert_not_called()
+    assert provider.await_count == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("sdk_object", [False, True])
+@pytest.mark.parametrize("tool_id", ["toolu_valid", "a" * 200])
+async def test_valid_dictionary_and_sdk_blocks_keep_native_feedback(sdk_object, tool_id):
+    block = tool_block(tool_id=tool_id)
+    if sdk_object:
+        block = SimpleNamespace(**block)
+    agent, provider, handler, req = setup_agent([
+        response([block]), response([{"type": "text", "text": "Controlled answer"}], stop="end_turn")])
+    result = await agent.handle(req)
+    assert result.success and result.status == "success" and result.tools_used == ["probe"]
+    assert provider.await_count == 2
+    handler.assert_awaited_once_with(req, {})
+    feedback = provider.await_args_list[1].kwargs["messages"][-1]["content"][0]
+    assert feedback["type"] == "tool_result" and feedback["tool_use_id"] == tool_id
+    assert feedback["is_error"] is False
+
+
+@pytest.mark.asyncio
+async def test_text_only_truncation_keeps_partial_semantics():
+    agent, provider, handler, req = setup_agent([
+        response([{"type": "text", "text": "Incomplete text"}], stop="max_tokens")])
+    result = await agent.handle(req)
+    assert result.success and result.status == "partial" and result.error_code is None
+    assert agent.stats.success == 0
+    handler.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("error", [
+    TimeoutError("controlled timeout"),
+    APITimeoutError(request=httpx.Request("POST", "https://controlled.invalid/")),
+])
+async def test_provider_timeout_is_classified_without_tool_dispatch(error):
+    agent, provider, handler, req = setup_agent([error])
+    result = await agent.handle(req)
+    assert not result.success and result.error_code == "agent_timeout"
+    assert result.tools_used == result.tool_traces == req.tool_attempts == []
+    handler.assert_not_called()
+    assert provider.await_count == 1
+
+
+@pytest.mark.asyncio
+async def test_task_cancellation_is_not_changed_into_a_model_error():
+    agent, provider, handler, req = setup_agent([asyncio.CancelledError()])
+    with pytest.raises(asyncio.CancelledError):
+        await agent.handle(req)
+    handler.assert_not_called()

+async def read_demo_order(req: Request, args: Dict[str, Any]) -> Dict[str, Any]:
+    """读取可信演示会话所属的合成订单，不接受模型提供客户身份。"""
+    source = {"source": "serveflow-mysql-demo-v1", "is_demo": True}
+
+    def rejected(code: str) -> Dict[str, Any]:
+        return {**source, "success": False, "status": "unavailable", "error_code": code}
+
+    if not isinstance(args, dict) or set(args) != {"order_id"}:
+        return rejected("invalid_demo_order_arguments")
+    order_id = args["order_id"]
+    if not isinstance(order_id, str) or re.fullmatch(r"DEMO-[0-9]{4}", order_id) is None:
+        return rejected("invalid_demo_order_arguments")
+    customer_id = getattr(req, "demo_customer_id", None)
+    if not isinstance(customer_id, str) or customer_id not in {"demo-customer-a", "demo-customer-b"}:
+        return rejected("demo_session_required")
+    reader = getattr(req, "demo_order_reader", None)
+    if not callable(reader):
+        return rejected("demo_store_unavailable")
+    try:
+        result = await reader(customer_id, order_id)
+    except Exception:
+        # Provider/driver exceptions may contain SQL, paths or credentials.
+        return rejected("demo_store_unavailable")
+    if not isinstance(result, dict) or result.get("source") != source["source"] or result.get("is_demo") is not True:
+        return rejected("invalid_demo_order_result")
+    if result.get("status") == "not_found":
+        return result if result.get("order") is None else rejected("invalid_demo_order_result")
+    order = result.get("order")
+    if result.get("status") != "found" or not isinstance(order, dict):
+        return rejected("invalid_demo_order_result")
+    if order.get("order_id") != order_id or order.get("customer_id") != customer_id:
+        return rejected("invalid_demo_order_result")
+    return result
+
+

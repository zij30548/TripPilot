+@app.get('/demo/session')
+async def demo_session(request: HTTPRequest, response: Response):
+    from demo_business.session import COOKIE_NAME, DemoSessionError, LIFETIME
+    if _demo_store is None or _demo_sessions is None:
+        raise HTTPException(404, 'demo_not_enabled')
+    origin = request.headers.get('origin')
+    if request.headers.get('sec-fetch-site') == 'cross-site' or (origin and origin not in _demo_sessions.origins):
+        raise HTTPException(403, 'demo_origin_rejected')
+    token = request.cookies.get(COOKIE_NAME)
+    try:
+        claims = _demo_sessions.read(token)
+    except DemoSessionError:
+        token, claims = _demo_sessions.issue()
+        response.set_cookie(COOKIE_NAME, token, max_age=LIFETIME, httponly=True,
+                            secure=False, samesite='strict', path='/')
+    response.headers['Cache-Control'] = 'no-store'
+    return {
+        'enabled': True, 'is_demo': True,
+        'workspace_user_id': _demo_sessions.workspace_id(claims),
+        'customer_label': '演示客户A' if claims['customer'] == 'demo-customer-a' else '演示客户B',
+        'csrf_token': _demo_sessions.csrf(claims),
+        'expires_at': datetime.fromtimestamp(claims['exp'], timezone.utc).isoformat().replace('+00:00', 'Z'),
+        'sample_orders': _demo_store.list_sample_orders(claims['customer']),
+    }
+
+
+@app.get('/demo/orders/{order_id}')
+async def demo_order(order_id: str, request: HTTPRequest, response: Response):
+    from demo_business.store import DemoStoreError
+    claims = _require_demo_session(request)
+    if request.query_params or not re.fullmatch(r'DEMO-[0-9]{4}', order_id):
+        raise HTTPException(400, 'demo_order_id_invalid')
+    try:
+        result = await _demo_store.read_order(claims['customer'], order_id)
+    except DemoStoreError:
+        raise HTTPException(503, 'demo_store_unavailable') from None
+    response.headers['Cache-Control'] = 'no-store'
+    return result
+

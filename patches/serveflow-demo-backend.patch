+@pytest.mark.asyncio
+async def test_chat_authority_is_server_bound_and_checked_before_model(demo, monkeypatch):
+    store, sessions = demo
+    captured = []
+
+    @asynccontextmanager
+    async def conversation(*args):
+        yield
+
+    intent = SimpleNamespace(intent=IntentCategory.ORDER_STATUS, intent_group='query',

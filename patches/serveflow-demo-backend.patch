+            _demo_sessions.verify_write(claims, request.headers.get('origin'),
+                                        request.headers.get('x-serveflow-demo-csrf'))
+        return claims
+    except DemoSessionError as exc:
+        status = 403 if exc.code in {'demo_origin_rejected', 'demo_csrf_rejected'} else 401
+        raise HTTPException(status, exc.code) from None
+
